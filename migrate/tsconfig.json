{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "dist",
        "rootDir": "src",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": false,
        "resolveJsonModule": true,
        "isolatedModules": true
    },
    "include": ["src/**/*"]
}
