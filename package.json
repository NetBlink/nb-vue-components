{
    "name": "@netblink/vue-components",
    "version": "3.0.1",
    "description": "",
    "type": "module",
    "main": "dist/nb-vue-components.es.js",
    "module": "dist/nb-vue-components.es.js",
    "types": "dist/types/index.d.ts",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/nb-vue-components.es.js"
        },
        "./icons": {
            "types": "./dist/types/icons/index.d.ts",
            "import": "./dist/icons.es.js"
        },
        "./icons/fa": {
            "types": "./dist/types/icons/presets/fa.d.ts",
            "import": "./dist/icons/fa.es.js"
        },
        "./icons/heroicons": {
            "types": "./dist/types/icons/presets/heroicons.d.ts",
            "import": "./dist/icons/heroicons.es.js"
        },
        "./icons/material": {
            "types": "./dist/types/icons/presets/material.d.ts",
            "import": "./dist/icons/material.es.js"
        },
        "./icons/solar": {
            "types": "./dist/types/icons/presets/solar.d.ts",
            "import": "./dist/icons/solar.es.js"
        },
        "./icons/lucide": {
            "types": "./dist/types/icons/presets/lucide.d.ts",
            "import": "./dist/icons/lucide.es.js"
        }
    },
    "scripts": {
        "start": "vite dev",
        "build": "vite build",
        "test": "vite preview",
        "docs:dev": "vite --config vite.config.docs.mjs",
        "docs:build": "vite build --config vite.config.docs.mjs",
        "docs:preview": "vite preview --config vite.config.docs.mjs",
        "prettier": "npx prettier **/* --write --ignore-path ./.prettierignore --ignore-unknown --list-different",
        "prettier-check": "npx prettier **/* --check --ignore-path ./.prettierignore --ignore-unknown",
        "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NetBlink/nb-vue-components.git"
    },
    "prettier": {
        "$schema": "http://json.schemastore.org/prettierrc",
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": true,
        "plugins": [
            "prettier-plugin-tailwindcss"
        ],
        "overrides": [
            {
                "files": [
                    "*.vue"
                ],
                "options": {
                    "printWidth": 150,
                    "htmlWhitespaceSensitivity": "ignore"
                }
            }
        ]
    },
    "keywords": [],
    "author": "Lukasz Tlalka",
    "homepage": "https://github.com/NetBlink/nb-vue-components#readme",
    "license": "ISC",
    "devDependencies": {
        "@fortawesome/fontawesome-svg-core": "^6.7.2",
        "@fortawesome/free-brands-svg-icons": "^6.7.2",
        "@fortawesome/free-regular-svg-icons": "^6.7.2",
        "@fortawesome/free-solid-svg-icons": "^6.7.2",
        "@fortawesome/vue-fontawesome": "^3.2.0",
        "@heroicons/vue": "^2.2.0",
        "@iconify-icons/heroicons": "^1.2.9",
        "@iconify-icons/material-symbols": "^1.2.58",
        "@iconify-icons/solar": "^1.2.3",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/material-symbols": "^1.2.73",
        "@iconify-json/solar": "^1.2.5",
        "@iconify/vue": "^4.0.0",
        "@inertiajs/vue3": "^2.0.5",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/postcss": "^4.1.5",
        "@tailwindcss/vite": "^4.1.5",
        "@vitejs/plugin-vue": "^5.0.0",
        "@vuepic/vue-datepicker": "^5.2.1",
        "apexcharts": "^6.7.0",
        "colord": "^2.9.3",
        "gh-pages": "^6.1.1",
        "js-md5": "^0.8.3",
        "laravel-vite-plugin": "^1.0.2",
        "postcss": "^8.4.35",
        "prettier": "3.0.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "reka-ui": "^2.2.1",
        "tailwindcss": "^4.1.5",
        "tw-elements": "1.0.0",
        "typescript": "^5.5.2",
        "vite": "^6.2.1",
        "vue": "^3.5.13",
        "vue-recaptcha-v3": "^2.0.1",
        "vue-search-select": "^3.1.0",
        "vue-select": "^4.0.0-beta.6",
        "vue-tsc": "^2.1.10",
        "vue3-apexcharts": "^1.11.1",
        "vue3-carousel": "^0.3.1",
        "vue3-dropzone": "^2.1.2",
        "vue3-highlightjs": "^1.0.5"
    },
    "dependencies": {
        "isomorphic-dompurify": "^2.36.0"
    },
    "overrides": {
        "axios": "^1.16.1"
    },
    "peerDependencies": {
        "@fortawesome/fontawesome-svg-core": "^6.4.0",
        "@fortawesome/free-brands-svg-icons": "^6.4.0",
        "@fortawesome/free-regular-svg-icons": "^6.4.0",
        "@fortawesome/free-solid-svg-icons": "^6.4.0",
        "@fortawesome/vue-fontawesome": "^3.0.3",
        "@iconify/vue": "^4.0.0",
        "vue": "^3.5.0"
    },
    "peerDependenciesMeta": {
        "@fortawesome/fontawesome-svg-core": {
            "optional": true
        },
        "@fortawesome/vue-fontawesome": {
            "optional": true
        },
        "@fortawesome/free-solid-svg-icons": {
            "optional": true
        },
        "@fortawesome/free-brands-svg-icons": {
            "optional": true
        },
        "@fortawesome/free-regular-svg-icons": {
            "optional": true
        },
        "@iconify/vue": {
            "optional": true
        }
    }
}
