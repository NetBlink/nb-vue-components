    ],
    "classTargetChanges": [
        {
            "component": "DropdownLink",
            "change": "`class` and attrs now land only on the link. 3.x also put them on the menu item wrapper."
        },
        {
            "component": "Collapse",
            "change": "`class` now lands only on the collapsible wrapper and other attrs only on the trigger button. 3.x put both on both; use `:ui=\"{ trigger: '...' }\"` to style the button."
        },
        {
            "component": "Tooltip",
            "change": "`class` and other attrs (`id`, `data-*`, listeners) now land on the tooltip bubble. 3.x dropped them."
        },
        {
            "component": "Modal",
            "change": "`class` now styles the panel, and other attrs (`id`, `data-*`, listeners) land on the modal container. 3.x dropped them."
        },
        {
            "component": "Images",
            "change": "`class` now lands on the upload form. 3.x dropped it (the component has two root elements)."
        },
        {
            "component": "Toaster",
            "change": "`class` and attrs now reach the toast viewport."
        },
        {
            "component": "TrPlaceholder",
            "change": "`class` and attrs now land on every placeholder row."
        }
    ],
    "kept": [
        {
            "component": "Button",
            "prop": "theme=\"no-style\"",
            "note": "Still strips the base styles."
        },
        {
            "component": "LinkButton",
            "prop": "theme=\"no-style\"",
            "note": "Still strips the base styles."
        },
        {
            "component": "Section",
            "prop": "unstyled",
            "note": "Still drops the default container styling."
        },
        {
            "component": "Spinner",
            "prop": "color",
            "note": "Not an override alias: it replaces the default colour classes, as before."
        },
        {
            "component": "NewModal",
            "prop": "backdropDuration, modalDuration",
            "note": "Unchanged."
        },
        {
            "component": "Modal",
            "prop": "backdropDuration, modalDuration",
            "note": "Unchanged."
        }
    ],
    "propRenames": [
        {
            "component": "Tbody",
            "prop": "noRecordsMessage",
            "replacement": "emptyMessage",
            "note": "In 3.x `emptyMessage` always had a default, so `noRecordsMessage` was never shown. 4.0 honours it while deprecated, which can change the text on tables that set it."
        }
    ]
}
