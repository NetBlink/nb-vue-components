            "replacement": "ui.stat",
            "semantics": "merge"
        },
        {
            "component": "Stats",
            "prop": "customStatValueClass",
            "part": "value",
            "replacement": "ui.value",
            "semantics": "merge"
        },
        {
            "component": "Stats",
            "prop": "customStatLabelClass",
            "part": "label",
            "replacement": "ui.label",
            "semantics": "merge"
        },
        {
            "component": "DataTile",
            "prop": "customStatClass",
            "part": "root",
            "replacement": "class",
            "semantics": "merge"
        },
        {
            "component": "DataTile",
            "prop": "customStatValueClass",
            "part": "value",
