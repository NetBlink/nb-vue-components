            "component": "NewModal",
            "prop": "backdropCustomClass",
            "part": "overlay",
            "replacement": "ui.overlay",
            "semantics": "merge",
            "note": "`backdropDuration` and `modalDuration` are kept."
        },
        {
            "component": "Modal",
            "prop": "modalCustomClass",
            "part": "content",
            "replacement": "class",
            "semantics": "merge",
            "note": "`class` on Modal now styles the panel (in 3.x it was dropped, since Modal renders a teleport). Modal itself is deprecated: rename the tag to NewModal."
        },
        {
            "component": "Modal",
            "prop": "backdropCustomClass",
            "part": "overlay",
            "replacement": "ui.overlay",
            "semantics": "merge"
        },
        {
            "component": "Tooltip",
            "prop": "contentClass",
            "part": "content",
            "replacement": "class",
            "semantics": "merge",
            "note": "`class` on Tooltip now styles the bubble. In 3.x a `class` on Tooltip was silently dropped, so check existing `class` attributes on Tooltip after upgrading."
        },
        {
            "component": "Tooltip",
            "prop": "arrowClass",
            "part": "arrow",
            "replacement": "ui.arrow",
            "semantics": "merge"
        },
        {
            "component": "Pagination",
            "prop": "customListClass",
