{
    "from": "3.x",
    "to": "4.0.0",
    "about": "Every deprecated 3.x override prop and the 4.0 part it maps to. Input for the 3-to-4 upgrade step. The deprecated props still work in 4.x (each warns once in development) and are removed in 5.0.",
    "replacementSyntax": {
        "class": "Move the value to the `class` attribute. If the element already has a `class`, combine them.",
        "ui.<part>": "Move the value to `:ui=\"{ <part>: '...' }\"`. Merge with an existing `:ui` object if there is one."
    },
    "semantics": {
        "merge": "3.x appended these classes next to the defaults, so a clashing default could still win and apps used `!` to force it. 4.0 merges them: a clashing default is removed and non-clashing defaults stay. Leading or trailing `!` (important) markers added only to beat a default can be dropped.",
        "replace": "3.x replaced the defaults with these classes.",
        "none": "The prop never had an effect."
    },
    "renames": [
        {
            "component": "Button",
            "prop": "customClass",
            "part": "root",
            "replacement": "class",
            "semantics": "merge"
        },
        {
            "component": "PrimaryButton",
            "prop": "customButtonClass",
            "part": "root",
            "replacement": "class",
            "semantics": "merge"
        },
        {
            "component": "SecondaryButton",
            "prop": "customClass",
            "part": "root",
            "replacement": "class",
            "semantics": "merge"
        },
        {
            "component": "DangerButton",
            "prop": "customClass",
            "part": "root",
            "replacement": "class",
            "semantics": "merge"
        },
        {
            "component": "WarningButton",
            "prop": "customClass",
            "part": "root",
            "replacement": "class",
            "semantics": "merge"
        },
        {
            "component": "InfoButton",
            "prop": "customClass",
            "part": "root",
            "replacement": "class",
            "semantics": "merge"
        },
        {
            "component": "SuccessButton",
            "prop": "customClass",
            "part": "root",
            "replacement": "class",
            "semantics": "merge"
        },
        {
            "component": "SubmitButton",
            "prop": "customButtonClass",
            "part": "root",
            "replacement": "class",
            "semantics": "merge"
        },
        {
            "component": "LinkButton",
            "prop": "colourClasses",
            "part": "root",
            "replacement": "class",
            "semantics": "replace",
            "note": "Replaced the theme and base classes entirely in 3.x and still does while deprecated. A `class` or `ui.root` merges instead, so the faithful rewrite is `theme=\"no-style\"` plus `:class=\"[...]\"` (the array value can be joined into one string)."
        },
        {
            "component": "Input",
            "prop": "inputCustomClass",
            "part": "input",
            "replacement": "ui.input",
            "semantics": "merge"
        },
        {
            "component": "Input",
            "prop": "labelCustomClass",
            "part": "label",
            "replacement": "ui.label",
            "semantics": "merge"
        },
        {
            "component": "Input",
            "prop": "buttonCustomClass",
            "part": "button",
            "replacement": "ui.button",
            "semantics": "merge"
        },
        {
            "component": "Input",
            "prop": "checkboxCustomClass",
            "part": null,
            "replacement": null,
            "semantics": "none",
            "note": "Never had an effect in 3.x (Input did not pass it on). Remove it; to style the checkbox use `:ui=\"{ input: '...' }\"` with `type=\"checkbox\"`."
        },
        {
            "component": "Textarea",
            "prop": "customClass",
            "part": "input",
            "replacement": "ui.input",
            "semantics": "merge"
        },
        {
            "component": "Textarea",
            "prop": "labelCustomClass",
            "part": "label",
            "replacement": "ui.label",
            "semantics": "merge"
        },
        {
            "component": "Textarea",
            "prop": "buttonCustomClass",
            "part": "button",
            "replacement": "ui.button",
            "semantics": "merge"
        },
        {
            "component": "Switch",
